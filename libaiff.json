{
    "name": "libaiff",
    "version": "1.0.1",
    "description": "AIFF audio decoder",
    "filters":["aiffdec","rfaiff"],
    "help": "This filter decodes AIFF/AIFC audio files using libaiff.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libaiff.accessor",
    "filter_source":{
        "aiffdec" : "dec_aiff.c",
        "rfaiff" : "reframe_aiff.c"
    },
    "extension":{
      "aif" : "audio",
      "aiff" : "audio",
      "aifc" : "audio"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1"],
    "patents": {
        "status": "royalty-free",
        "note": "AIFF carries uncompressed PCM (and IMA/ULAW variants); no patent pool",
        "checked": "2026-10-17"
    }
}
